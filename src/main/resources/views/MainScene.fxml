<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<!--
    MainScene.fxml
    ══════════════════════════════════════════════════════════════
    CSS spec  : position relative | width 1440px | height 820px
    Background: #FFFFFF (content area) / #FFE4CC (nav + sidebar)

    Structure
    ─────────
    BorderPane (1440 × 820)
      ├── top   : HBox  — top navigation bar   (h=100, bg #FFE4CC)
      ├── left  : AnchorPane — sidebar          (w=104, bg #FFE4CC)
      │             Six 73×73 icon buttons at
      │             y = 66 | 166 | 266 | 366 | 466 | 566
      └── center: StackPane — inner view holder (bg #FFFFFF)
                    Controllers swap children of this pane
                    to navigate between screens.

    Controller wires:
      • MainController.java owns the root BorderPane
      • Call MainController#loadView(String fxmlPath) to swap
        the active screen inside #contentPane
      • Each sidebar button calls its matching #onNav* handler
      • The active button gets styleClass "sidebar-btn-active"
    ══════════════════════════════════════════════════════════════
-->
<BorderPane
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.app.controller.MainController"
    fx:id="rootPane"
    prefWidth="1440"
    prefHeight="820"
    minWidth="1440"
    minHeight="820"
    maxWidth="1440"
    maxHeight="820"
    style="-fx-background-color: #FFFFFF;">

    <!-- ══════════════════════════════════════════════════════
         TOP NAVIGATION BAR
         SVG ref: Cost_estimation top bar
              rect y=-1, h=102, fill=#FFE4CC, stroke=#1D0000
         ══════════════════════════════════════════════════════ -->
    <top>
        <HBox
            fx:id="topNavBar"
            prefHeight="100"
            prefWidth="1440"
            alignment="CENTER_LEFT"
            style="-fx-background-color: #FFE4CC;
                   -fx-border-color: #1D0000;
                   -fx-border-width: 0 0 2 0;
                   -fx-padding: 0 24 0 24;">

            <!-- ── Brand ── -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView
                    fx:id="brandLogoView"
                    fitWidth="52"
                    fitHeight="52"
                    preserveRatio="true"/>
                <Label
                    fx:id="appNameLabel"
                    text="Shipment"
                    style="-fx-font-size: 26px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #000000;"/>
            </HBox>

            <!-- ── Centre nav links ── -->
            <HBox alignment="CENTER" spacing="32" HBox.hgrow="ALWAYS">
                <Button
                    fx:id="navBtnHome"
                    text="Home"
                    onAction="#onNavHome"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-cursor: hand;"/>
                <Button
                    fx:id="navBtnNewShipment"
                    text="New Shipment"
                    onAction="#onNavNewShipment"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-cursor: hand;"/>
                <Button
                    fx:id="navBtnSchedule"
                    text="Schedule"
                    onAction="#onNavSchedule"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-cursor: hand;"/>
                <Button
                    fx:id="navBtnShipmentOrder"
                    text="Shipment Order"
                    onAction="#onNavShipmentOrder"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-cursor: hand;"/>
                <Button
                    fx:id="navBtnCostEstimate"
                    text="Cost Estimate"
                    onAction="#onNavCostEstimate"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>
            </HBox>

            <!-- ── Right: date + profile ── -->
            <HBox alignment="CENTER_RIGHT" spacing="16">
                <Label
                    fx:id="currentDateLabel"
                    text=""
                    style="-fx-font-size: 13px;
                           -fx-text-fill: #000000;"/>
                <!--
                    Profile button: SVG circle r=24.5 at x≈1382,y=54
                    White fill, black stroke-width=1
                -->
                <Button
                    fx:id="profileButton"
                    onAction="#onProfileClicked"
                    prefWidth="50"
                    prefHeight="50"
                    style="-fx-background-color: #FFFFFF;
                           -fx-border-color: #000000;
                           -fx-border-width: 1;
                           -fx-border-radius: 25;
                           -fx-background-radius: 25;
                           -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════════
         LEFT SIDEBAR  (Component_3.svg)
         SVG: w=104, h=724
              outer rect x=1,y=1,w=102,h=722
              fill=#FFE4CC, stroke=black, stroke-width=2

         6 icon buttons, each 73×73, rx=9, stroke=black, sw=2
         y positions (absolute in SVG): 66,166,266,366,466,566
         Spacing between buttons = 100px (73 height + 27 gap)

         Icons (top→bottom):
           1. Add / New shipment   (plus-circle)
           2. Checklist / Orders
           3. Calendar / Schedule
           4. Map pin / Locations
           5. Wrench / Tools
           6. User / Profile
         ══════════════════════════════════════════════════════ -->
    <left>
        <AnchorPane
            fx:id="sidebarPane"
            prefWidth="104"
            minWidth="104"
            maxWidth="104"
            style="-fx-background-color: #FFE4CC;
                   -fx-border-color: #000000;
                   -fx-border-width: 0 2 0 0;">

            <!--
                Button 1 — Add / New Shipment
                SVG y=66  →  layoutY=66
                Active by default (filled dark = #5D3F25)
            -->
            <Button
                fx:id="sidebarBtn1"
                onAction="#onSidebarNew"
                prefWidth="73"
                prefHeight="73"
                layoutX="16"
                layoutY="66"
                style="-fx-background-color: #5D3F25;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;"
                AnchorPane.leftAnchor="16"
                AnchorPane.topAnchor="66"/>

            <!--
                Button 2 — Checklist / Orders
                SVG y=166
            -->
            <Button
                fx:id="sidebarBtn2"
                onAction="#onSidebarChecklist"
                prefWidth="73"
                prefHeight="73"
                layoutX="16"
                layoutY="166"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;"
                AnchorPane.leftAnchor="16"
                AnchorPane.topAnchor="166"/>

            <!--
                Button 3 — Calendar / Schedule
                SVG y=266
            -->
            <Button
                fx:id="sidebarBtn3"
                onAction="#onSidebarCalendar"
                prefWidth="73"
                prefHeight="73"
                layoutX="16"
                layoutY="266"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;"
                AnchorPane.leftAnchor="16"
                AnchorPane.topAnchor="266"/>

            <!--
                Button 4 — Map pin / Locations
                SVG y=366
            -->
            <Button
                fx:id="sidebarBtn4"
                onAction="#onSidebarMap"
                prefWidth="73"
                prefHeight="73"
                layoutX="16"
                layoutY="366"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;"
                AnchorPane.leftAnchor="16"
                AnchorPane.topAnchor="366"/>

            <!--
                Button 5 — Wrench / Tools
                SVG y=466
            -->
            <Button
                fx:id="sidebarBtn5"
                onAction="#onSidebarTools"
                prefWidth="73"
                prefHeight="73"
                layoutX="17"
                layoutY="466"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;"
                AnchorPane.leftAnchor="17"
                AnchorPane.topAnchor="466"/>

            <!--
                Button 6 — User / Profile
                SVG y=566
            -->
            <Button
                fx:id="sidebarBtn6"
                onAction="#onSidebarProfile"
                prefWidth="73"
                prefHeight="73"
                layoutX="17"
                layoutY="566"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;"
                AnchorPane.leftAnchor="17"
                AnchorPane.topAnchor="566"/>

        </AnchorPane>
    </left>

    <!-- ══════════════════════════════════════════════════════
         CONTENT PANE  — inner view holder
         StackPane so child screens stack/replace cleanly.
         Background #FFFFFF per CSS spec.

         Usage in MainController.java:
         ─────────────────────────────
         @FXML private StackPane contentPane;

         private void loadView(String fxmlPath) {
             FXMLLoader loader = new FXMLLoader(
                 getClass().getResource(fxmlPath));
             Node view = loader.load();
             contentPane.getChildren().setAll(view);
         }

         // In each sidebar/nav handler:
         private void onNavCostEstimate() {
             loadView("/com/app/view/Cost_estimation.fxml");
             setActiveButton(sidebarBtn1);
         }
         ══════════════════════════════════════════════════════ -->
    <center>
        <StackPane
            fx:id="contentPane"
            style="-fx-background-color: #FFFFFF;">

            <!--
                Placeholder shown before any view is loaded.
                The controller removes this once the first
                screen is pushed into contentPane.
            -->
            <Label
                fx:id="placeholderLabel"
                text="Loading…"
                style="-fx-font-size: 18px;
                       -fx-text-fill: #B3B3B3;"/>

        </StackPane>
    </center>

</BorderPane>
