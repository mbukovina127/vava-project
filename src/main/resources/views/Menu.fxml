<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- Wrap everything in a StackPane -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.shippin.controller.MenuController"
           stylesheets="@../css/menu-page.css"
           prefWidth="1440" prefHeight="820"
           minWidth="1440" minHeight="820"
           maxWidth="1440" maxHeight="820">
           
	<BorderPane styleClass="menu-root">
	        
	    <top>
	        <HBox
	                fx:id="topNavBar"
	                prefHeight="100"
	                prefWidth="1440"
	                alignment="CENTER_LEFT"
	                styleClass="nav-bar">
	
	            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
	                <ImageView
	                        fx:id="brandLogoImageView"
	                        fitWidth="55"
	                        fitHeight="55"
	                        preserveRatio="true"/>
	                <Label
	                        fx:id="appNameLabel"
	                        text="Shipinn"
	                        styleClass="nav-app-name"/>
	            </HBox>
	
	            <HBox alignment="CENTER_RIGHT" spacing="14">
	                <Label
	                        fx:id="UserNameLabel"
	                        text=""
	                        styleClass="nav-date"/>
	                <Button
	                        fx:id="profileButton"
	                        onAction="#onProfileClicked"
	                        styleClass="profile-btn"/>
	            </HBox>
	        </HBox>
	    </top>
	
	    <left>
	        <VBox
	                fx:id="leftSidebar"
	                prefWidth="100"
	                prefHeight="720"
	                spacing="0"
	                alignment="TOP_CENTER"
	                styleClass="sidebar">
	
	            <!--This is where the menu is loaded-->
	
	        </VBox>
	    </left>
	
	    <center>
	        <ScrollPane fitToWidth="true"
	                    fitToHeight="true"
	                    pannable="true"
	                    styleClass="content-scroll">
	            <content>
	                <StackPane fx:id="contentArea"
	                           styleClass="content-area"
	                           maxWidth="Infinity"
	                           maxHeight="Infinity">
	                    <padding>
	                        <Insets top="24" right="24" bottom="24" left="24"/>
	                    </padding>
	                </StackPane>
	            </content>
	        </ScrollPane>
	    </center>
	    
	</BorderPane>

    <!-- Overlay is now a sibling of BorderPane, so it stacks on top -->
    <StackPane fx:id="modalOverlay"
               visible="false"
               managed="false"
               pickOnBounds="true"
               styleClass="modal-overlay"/>
               
    <VBox fx:id="modalContentHolder"
              managed="false"
              visible="false"
              maxWidth="620.0"
              alignment="CENTER"/>

</StackPane>
