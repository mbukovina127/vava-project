<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<StackPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.shippin.controller.RegisterController"
        prefWidth="1440"
        prefHeight="820"
        styleClass="root-pane"
        stylesheets="@../css/shipinn.css, @../css/register-page.css">

    <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="12" right="16"/></padding>
        <Button
                fx:id="langButton"
                text="SK"
                onAction="#onToggleLanguage"
                styleClass="profile-btn"/>
    </HBox>

    <VBox
            styleClass="card"
            maxWidth="380"
            spacing="0"
            alignment="TOP_CENTER">

        <!-- Logo -->
        <HBox styleClass="logo-box">
            <ImageView fitHeight="40" preserveRatio="true">
                <Image url="@../icons/png-dark/logoShippin_black.png"/>
            </ImageView>
            <Label styleClass="logo-name" text="%register.logo"/>
        </HBox>

        <!-- Name + Surname row -->
        <GridPane styleClass="name-row" hgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <!-- Name -->
            <VBox GridPane.columnIndex="0" spacing="4">
                <Label styleClass="field-label" text="%register.name"/>
                <TextField
                        fx:id="firstNameField"
                        styleClass="input-field"
                        promptText="%register.name.prompt"/>
            </VBox>

            <!-- Surname -->
            <VBox GridPane.columnIndex="1" spacing="4">
                <Label styleClass="field-label" text="%register.surname"/>
                <TextField
                        fx:id="lastNameField"
                        styleClass="input-field"
                        promptText="%register.surname.prompt"/>

            </VBox>

        </GridPane>

        <!-- error label (ame) -->
        <Label
                fx:id="statusLabelName"
                styleClass="status-label"
                text=""
                wrapText="true"
                maxWidth="360"/>

        <!-- Spacer -->
        <Region prefHeight="12"/>

        <!-- Email -->
        <Label styleClass="field-label" text="%register.email"/>
        <TextField
                fx:id="emailField"
                styleClass="input-field"
                promptText="%register.email.prompt"/>

        <!-- error label (email) -->
        <Label
                fx:id="statusLabelEmail"
                styleClass="status-label"
                text=""
                wrapText="true"
                maxWidth="360"/>

        <!-- Spacer -->
        <Region prefHeight="12"/>

        <!-- Password -->
        <Label styleClass="field-label" text="%register.password"/>
        <HBox fx:id="passwordWrapper" styleClass="password-wrapper" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <PasswordField
                    fx:id="passwordField"
                    styleClass="password-input"
                    promptText="%register.password.prompt"
                    HBox.hgrow="ALWAYS"/>
            <TextField
                    fx:id="passwordVisible"
                    styleClass="password-input"
                    promptText="%register.password.prompt"
                    managed="false"
                    visible="false"
                    HBox.hgrow="ALWAYS"/>
            <Button
                    fx:id="eyeButton"
                    styleClass="eye-btn"
                    text="◉"
                    onAction="#onTogglePassword"/>
        </HBox>

        <!-- error label (password) -->
        <Label
                fx:id="statusLabelPass"
                styleClass="status-label"
                text=""
                wrapText="true"
                maxWidth="360"/>

        <!-- Spacer -->
        <Region prefHeight="12"/>

        <!-- Repeat Password -->
        <Label styleClass="field-label" text="%register.repeat_password"/>
        <HBox fx:id="passwordWrapperRep" styleClass="password-wrapper" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <PasswordField
                    fx:id="passwordFieldRep"
                    styleClass="password-input"
                    promptText="%register.password.prompt"
                    HBox.hgrow="ALWAYS"/>
            <TextField
                    fx:id="passwordVisibleRep"
                    styleClass="password-input"
                    promptText="%register.password.prompt"
                    managed="false"
                    visible="false"
                    HBox.hgrow="ALWAYS"/>
            <Button
                    fx:id="eyeButtonRep"
                    styleClass="eye-btn"
                    text="◉"
                    onAction="#onTogglePasswordRep"/>
        </HBox>

        <!-- error label (email) -->
        <Label
                fx:id="statusLabelPassConfirm"
                styleClass="status-label"
                text=""
                wrapText="true"
                maxWidth="360"/>

        <!-- Sign up button -->
        <Button
                fx:id="registerButton"
                styleClass="primary-button"
                text="%register.button"
                maxWidth="Infinity"
                onAction="#onRegister"/>

        <!-- Login link -->
        <HBox styleClass="bottom-link-box">
            <Label styleClass="muted-text" text="%register.have_account"/>
            <Hyperlink
                    fx:id="loginLink"
                    styleClass="register-link"
                    text="%register.login_link"
                    onAction="#onGoToLogin"/>
        </HBox>

    </VBox>

</StackPane>