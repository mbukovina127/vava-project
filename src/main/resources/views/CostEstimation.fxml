<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1340" styleClass="screen-root" stylesheets="@../css/shipinn.css, @../css/cost_estimation.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.shippin.controller.CostEstimationController">

    <!-- TITLE ROW -->
    <HBox alignment="CENTER_LEFT" styleClass="ce-title-row">
        <Label fx:id="sectionTitleLabel" styleClass="page-title" text="%cost_estimation.title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="viewRegionsButton" onAction="#onViewRegions" styleClass="secondary-button" text="%cost_estimation.view_regions">
            <HBox.margin><Insets right="8" /></HBox.margin>
        </Button>
    </HBox>

    <!-- FIELDS ROW -->
    <GridPane hgap="10" styleClass="ce-fields-grid" vgap="0">
        <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
        <columnConstraints>
            <!-- Col 0: Row label (Postal codes / Size / Coefficients) -->
            <ColumnConstraints halignment="LEFT" maxWidth="140.0" minWidth="110.0" prefWidth="120.0" />
            <!-- Col 1: Sub-label From/Weight/Fuel -->
            <ColumnConstraints halignment="RIGHT" maxWidth="140.0" minWidth="100.0" prefWidth="120.0" />
            <!-- Col 2: From field -->
            <ColumnConstraints maxWidth="220.0" minWidth="160.0" prefWidth="180.0" />
            <!-- Col 3: Status label — grows to fill remaining left-side space -->
            <ColumnConstraints hgrow="ALWAYS" minWidth="120.0" prefWidth="160.0" />
            <!-- Col 4: Spacer -->
            <ColumnConstraints maxWidth="24.0" minWidth="8.0" prefWidth="16.0" />
            <!-- Col 5: Sub-label To/Volume/Toll -->
            <ColumnConstraints halignment="RIGHT" maxWidth="140.0" minWidth="100.0" prefWidth="120.0" />
            <!-- Col 6: To field + button -->
            <ColumnConstraints maxWidth="220.0" minWidth="160.0" prefWidth="180.0" />
            <!-- Col 7: Status label — grows to fill remaining right-side space -->
            <ColumnConstraints hgrow="ALWAYS" minWidth="120.0" prefWidth="160.0" />
        </columnConstraints>
        <rowConstraints>
            <!-- Row 0: Postal codes -->
            <RowConstraints minHeight="40" prefHeight="44" valignment="CENTER" />
            <!-- Row 1: Status label destination — auto-grow pre dlhé texty -->
            <RowConstraints maxHeight="60" minHeight="20" prefHeight="24" valignment="TOP" vgrow="SOMETIMES" />
            <!-- Row 2: Size -->
            <RowConstraints minHeight="40" prefHeight="44" valignment="CENTER" />
            <!-- Row 3: Status labels weight / volume -->
            <RowConstraints maxHeight="60" minHeight="20" prefHeight="24" valignment="TOP" vgrow="SOMETIMES" />
            <!-- Row 4: Coefficients -->
            <RowConstraints minHeight="40" prefHeight="44" valignment="CENTER" />
            <!-- Row 5: Status labels fuel / toll -->
            <RowConstraints maxHeight="60" minHeight="20" prefHeight="24" valignment="TOP" vgrow="SOMETIMES" />
        </rowConstraints>

        <!-- ── Row 0: Postal codes ── -->
        <Label styleClass="field-label" text="%cost_estimation.postal_codes" GridPane.columnIndex="0" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.from" GridPane.columnIndex="1" />
        <ComboBox fx:id="fromCombo" maxWidth="Infinity" prefHeight="36" styleClass="ce-combo" GridPane.columnIndex="2" />

        <!-- Status label From — col 3 -->
        <Label fx:id="statusLabelFrom" maxWidth="Infinity" styleClass="status-label" wrapText="true" GridPane.columnIndex="3" GridPane.valignment="CENTER" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.to" GridPane.columnIndex="5" />
        <HBox fx:id="toBox" alignment="CENTER_LEFT" spacing="0" styleClass="ce-to-box" GridPane.columnIndex="6">
            <TextField fx:id="destinationField" maxWidth="Infinity" prefHeight="36" promptText="%cost_estimation.code" styleClass="ce-to-field" HBox.hgrow="ALWAYS" />
            <Button fx:id="toScanBtn" onAction="#onTestMap" styleClass="ce-icon-btn" text="⊕" />
        </HBox>

        <!-- ── Row 1: status label destination ── -->
        <Label fx:id="statusLabelDestination" maxWidth="Infinity" styleClass="status-label" wrapText="true" GridPane.columnIndex="6" GridPane.columnSpan="2" GridPane.rowIndex="1" />

        <!-- ── Row 2: Size ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.size" GridPane.columnIndex="0" GridPane.rowIndex="2" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.weight" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <TextField fx:id="weightField" maxWidth="Infinity" prefHeight="36" promptText="60.45" styleClass="input-field" GridPane.columnIndex="2" GridPane.rowIndex="2" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.volume" GridPane.columnIndex="5" GridPane.rowIndex="2" />
        <TextField fx:id="volumeField" maxWidth="Infinity" prefHeight="36" promptText="1.2" styleClass="input-field" GridPane.columnIndex="6" GridPane.rowIndex="2" />

        <!-- ── Row 3: status labels weight / volume ── -->
        <Label fx:id="statusLabelWeight" maxWidth="Infinity" styleClass="status-label" wrapText="true" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="3" />
        <Label fx:id="statusLabelVolume" maxWidth="Infinity" styleClass="status-label" wrapText="true" GridPane.columnIndex="6" GridPane.columnSpan="2" GridPane.rowIndex="3" />

        <!-- ── Row 4: Coefficients ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.coefficients" GridPane.columnIndex="0" GridPane.rowIndex="4" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.fuel_surcharge" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <TextField fx:id="fuelSurchargeField" maxWidth="Infinity" prefHeight="36" promptText="1.00 - 0.00" styleClass="input-field" GridPane.columnIndex="2" GridPane.rowIndex="4" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.toll" GridPane.columnIndex="5" GridPane.rowIndex="4" />
        <TextField fx:id="tollField" maxWidth="Infinity" prefHeight="36" promptText="1.00 - 0.00" styleClass="input-field" GridPane.columnIndex="6" GridPane.rowIndex="4" />

        <!-- ── Row 5: status labels fuel / toll ── -->
        <Label fx:id="statusLabelFuel" maxWidth="Infinity" styleClass="status-label" wrapText="true" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="5" />
        <Label fx:id="statusLabelToll" maxWidth="Infinity" styleClass="status-label" wrapText="true" GridPane.columnIndex="6" GridPane.columnSpan="2" GridPane.rowIndex="5" />
      <Label text="kg" GridPane.columnIndex="3" GridPane.rowIndex="2" />
      <Label GridPane.columnIndex="7" GridPane.rowIndex="2" />
      <Label text="m³" GridPane.columnIndex="7" GridPane.rowIndex="2" />

    </GridPane>

    <!-- ADDITIONAL FEES — dynamic sections -->
    <VBox styleClass="ce-fees-body">
        <padding><Insets top="80.0" /></padding>

        <!-- Produkty pre ZBS — radio buttons, populated from DB -->
        <VBox fx:id="productsContainer" spacing="10">
            <padding><Insets bottom="16.0" /></padding>
        </VBox>

        <!-- Obstarávané služby — checkboxes, populated from DB -->
        <VBox fx:id="servicesContainer" spacing="10">
            <padding><Insets bottom="16.0" /></padding>
        </VBox>

        <!-- Príplatky — checkboxes, populated from DB -->
        <VBox fx:id="paymentsContainer" spacing="10" />

    </VBox>

    <!-- BOTTOM ROW -->
    <HBox alignment="CENTER_LEFT" spacing="0" styleClass="ce-bottom-row">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="resetButton" onAction="#onReset" styleClass="secondary-button" text="%cost_estimation.reset" />
        <Button fx:id="computeButton" onAction="#onComputeCost" styleClass="primary-button" text="%cost_estimation.compute">
            <HBox.margin><Insets left="16" /></HBox.margin>
        </Button>
    </HBox>

</VBox>
