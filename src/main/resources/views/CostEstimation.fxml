<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>


<!--TODO: Responsible Error - mozete zbalit na cesty :)-->
<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.shippin.controller.CostEstimationController"
        styleClass="ce-root"
        stylesheets="@../css/cost_estimation.css"
        prefWidth="1340"
        spacing="0">

    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>

    <!-- TITLE ROW  —  "Shipment cost estimation"  +  Date -->
    <HBox styleClass="ce-title-row" alignment="CENTER_LEFT">
        <Label
                fx:id="sectionTitleLabel"
                text="Shipment cost estimation"
                styleClass="ce-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Label text="Date:" styleClass="ce-date-label"/>
            <TextField
                    fx:id="dateField"
                    promptText="DD.MM.YYYY"
                    prefWidth="130"
                    styleClass="input-field ce-date-field"/>
            <!-- error label (date) -->
            <Label
                    fx:id="statusLabelDate"
                    styleClass="status-label"
                    text=""
                    wrapText="true"
                    maxWidth="200"/>
        </HBox>
    </HBox>

    <!-- TYPE TOGGLES  —  Small Package / Shipment -->
    <HBox styleClass="ce-toggle-row" spacing="24" alignment="CENTER_LEFT">
        <RadioButton fx:id="rbSmallPackage"
                     text="Small Package"
                     toggleGroup="$typeGroup"
                     styleClass="ce-toggle"/>

        <RadioButton fx:id="rbShipment"
                     text="Shipment"
                     toggleGroup="$typeGroup"
                     selected="true"
                     styleClass="ce-toggle"/>
    </HBox>


    <!-- POSTAL CODES ROW -->
    <HBox styleClass="ce-field-row" alignment="TOP_LEFT" spacing="0">

        <!-- Label -->
        <Label text="Postal codes:" styleClass="ce-row-label" prefWidth="140"/>

        <!-- From -->
        <Label text="From:" styleClass="ce-sub-label" prefWidth="55"/>
        <ComboBox
                fx:id="fromCombo"
                value=""
                prefWidth="180"
                prefHeight="36"
                styleClass="ce-combo"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- To -->
        <Label text="To:" styleClass="ce-sub-label" prefWidth="35"/>
        <VBox spacing="2">
            <HBox styleClass="ce-to-box" alignment="CENTER_LEFT" spacing="0">
                <TextField
                        fx:id="destinationField"
                        prefWidth="200"
                        prefHeight="36"
                        styleClass="ce-to-field"/>
                <Button fx:id="toScanBtn" text="⊕" styleClass="ce-icon-btn"/>
            </HBox>
            <!-- error label (destination) -->
            <Label
                    fx:id="statusLabelDestination"
                    styleClass="status-label"
                    text=""
                    wrapText="true"
                    maxWidth="236"/>
        </VBox>
    </HBox>

    <!-- SIZE / WEIGHT / VOLUME ROW -->
    <HBox styleClass="ce-field-row" alignment="TOP_LEFT" spacing="0">
        <Label text="Size:" styleClass="ce-row-label" prefWidth="140"/>

        <VBox spacing="2">
            <TextField
                    fx:id="weightField"
                    prefWidth="180"
                    prefHeight="36"
                    styleClass="input-field"/>
            <!-- error label (weight) -->
            <Label
                    fx:id="statusLabelWeight"
                    styleClass="status-label"
                    text=""
                    wrapText="true"
                    maxWidth="180"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Volume:" styleClass="ce-sub-label" prefWidth="70"/>

        <VBox spacing="2">
            <TextField
                    fx:id="volumeField"
                    prefWidth="200"
                    prefHeight="36"
                    styleClass="input-field"/>
            <!-- error label (volume) -->
            <Label
                    fx:id="statusLabelVolume"
                    styleClass="status-label"
                    text=""
                    wrapText="true"
                    maxWidth="200"/>
        </VBox>
    </HBox>

    <!-- COEFFICIENTS / FUEL SURCHARGE / TOLL ROW -->
    <HBox styleClass="ce-field-row" alignment="CENTER_LEFT" spacing="0">
        <Label text="Coefficients:" styleClass="ce-row-label" prefWidth="140"/>
        <Label text="Fuel surcharge:" styleClass="ce-sub-label" prefWidth="110"/>
        <TextField
                fx:id="fuelSurchargeField"
                prefWidth="180"
                prefHeight="36"
                styleClass="input-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Toll:" styleClass="ce-sub-label" prefWidth="70"/>
        <TextField
                fx:id="tollField"
                prefWidth="200"
                prefHeight="36"
                styleClass="input-field"/>
    </HBox>


    <!-- ADDITIONAL FEES TOGGLE -->
    <HBox styleClass="ce-fees-header-row" alignment="CENTER_LEFT">
        <CheckBox fx:id="chkAdditionalFees" text="Additional fees:" styleClass="ce-toggle" selected="true"/>
    </HBox>

    <!-- ADDITIONAL FEES  —  two columns -->
    <HBox styleClass="ce-fees-body" spacing="60" alignment="TOP_LEFT">

        <!-- Left: Obstarávané služby -->
        <VBox spacing="10">
            <Label text="Obstarávané služby:" styleClass="ce-fees-group-label"/>
            <CheckBox fx:id="chkADR"         text="ADR tovar"    styleClass="ce-check"/>
            <CheckBox fx:id="chkDobierka"    text="Dobierka"     styleClass="ce-check"/>
            <CheckBox fx:id="chkPripoistenie" text="Pripoistenie" styleClass="ce-check"/>
            <CheckBox fx:id="chkVratenieEUP" text="Vrátenie EUP" styleClass="ce-check"/>
        </VBox>

        <!-- Right: Produkty pre ZBS  (2-column sub-grid) -->
        <VBox spacing="10">
            <Label text="Produkty pre ZBS:" styleClass="ce-fees-group-label"/>
            <GridPane hgap="40" vgap="10">
                <CheckBox fx:id="chkPremium"   text="Premium"    styleClass="ce-check" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <CheckBox fx:id="chkFIX"       text="FIX"        styleClass="ce-check" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <CheckBox fx:id="chkPremium10" text="Premium 10" styleClass="ce-check" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <CheckBox fx:id="chkFIX10"     text="FIX 10"     styleClass="ce-check" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <CheckBox fx:id="chkPremium13" text="Premium 13" styleClass="ce-check" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <CheckBox fx:id="chkFIX13"     text="FIX 13"     styleClass="ce-check" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>

    </HBox>

    <!-- STATUS  +  RESULT BOX -->
    <Label
            fx:id="statusLabel"
            text=""
            styleClass="status-label">
        <VBox.margin><Insets top="6"/></VBox.margin>
    </Label>

    <HBox
            fx:id="resultBox"
            spacing="14"
            alignment="CENTER_LEFT"
            visible="false"
            styleClass="ce-result-box">
        <Label text="Estimated Cost:" styleClass="ce-result-label"/>
        <Label fx:id="estimatedCostLabel" text="0.00 €" styleClass="ce-result-value"/>
    </HBox>

    <!--  BOTTOM ROW  —  dots  +  Reset / Compute -->
    <HBox alignment="CENTER_LEFT" spacing="0" styleClass="ce-bottom-row">
        <Label text="• • •" styleClass="ce-dots"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button
                fx:id="resetButton"
                text="Reset"
                onAction="#onReset"
                styleClass="ce-btn-reset"/>
        <Button
                fx:id="computeButton"
                text="Compute estimate"
                onAction="#onComputeCost"
                styleClass="ce-btn-compute">
            <HBox.margin><Insets left="16"/></HBox.margin>
        </Button>
    </HBox>
</VBox>