<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1340" styleClass="screen-root" stylesheets="@../css/shipinn.css, @../css/cost_estimation.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.shippin.controller.CostEstimationController">

    <!-- TITLE ROW -->
    <HBox alignment="CENTER_LEFT" styleClass="ce-title-row">
        <Label fx:id="sectionTitleLabel" styleClass="page-title" text="%cost_estimation.title" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- FIELDS ROW -->
    <GridPane hgap="10" vgap="0" styleClass="ce-fields-grid">
        <padding><Insets top="8" bottom="8" left="8" right="8" /></padding>
        <columnConstraints>
            <!-- Col 0: Row label (Postal codes / Size / Coefficients) -->
            <ColumnConstraints minWidth="110" prefWidth="120" maxWidth="140" halignment="LEFT" />
            <!-- Col 1: Sub-label From/Weight/Fuel -->
            <ColumnConstraints minWidth="100" prefWidth="120" maxWidth="140" halignment="RIGHT" />
            <!-- Col 2: From field -->
            <ColumnConstraints minWidth="160" prefWidth="180" maxWidth="220" />
            <!-- Col 3: Status label — grows to fill remaining left-side space -->
            <ColumnConstraints minWidth="120" prefWidth="160" hgrow="ALWAYS" />
            <!-- Col 4: Spacer -->
            <ColumnConstraints minWidth="8" prefWidth="16" maxWidth="24" />
            <!-- Col 5: Sub-label To/Volume/Toll -->
            <ColumnConstraints minWidth="100" prefWidth="120" maxWidth="140" halignment="RIGHT" />
            <!-- Col 6: To field + button -->
            <ColumnConstraints minWidth="160" prefWidth="180" maxWidth="220" />
            <!-- Col 7: Status label — grows to fill remaining right-side space -->
            <ColumnConstraints minWidth="120" prefWidth="160" hgrow="ALWAYS" />
        </columnConstraints>
        <rowConstraints>
            <!-- Row 0: Postal codes -->
            <RowConstraints minHeight="40" prefHeight="44" valignment="CENTER" />
            <!-- Row 1: Status label destination — auto-grow pre dlhé texty -->
            <RowConstraints minHeight="20" prefHeight="24" maxHeight="60" vgrow="SOMETIMES" valignment="TOP" />
            <!-- Row 2: Size -->
            <RowConstraints minHeight="40" prefHeight="44" valignment="CENTER" />
            <!-- Row 3: Status labels weight / volume -->
            <RowConstraints minHeight="20" prefHeight="24" maxHeight="60" vgrow="SOMETIMES" valignment="TOP" />
            <!-- Row 4: Coefficients -->
            <RowConstraints minHeight="40" prefHeight="44" valignment="CENTER" />
            <!-- Row 5: Status labels fuel / toll -->
            <RowConstraints minHeight="20" prefHeight="24" maxHeight="60" vgrow="SOMETIMES" valignment="TOP" />
        </rowConstraints>

        <!-- ── Row 0: Postal codes ── -->
        <Label styleClass="field-label" text="%cost_estimation.postal_codes"
               GridPane.columnIndex="0" GridPane.rowIndex="0" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.from"
               GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <ComboBox fx:id="fromCombo" prefHeight="36" maxWidth="Infinity" styleClass="ce-combo"
                  GridPane.columnIndex="2" GridPane.rowIndex="0" />

        <!-- Status label From — col 3 -->
        <Label fx:id="statusLabelFrom" maxWidth="Infinity" styleClass="status-label" wrapText="true"
               GridPane.columnIndex="3" GridPane.rowIndex="0" GridPane.valignment="CENTER" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.to"
               GridPane.columnIndex="5" GridPane.rowIndex="0" />
        <HBox fx:id="toBox" alignment="CENTER_LEFT" spacing="0" styleClass="input-field"
              GridPane.columnIndex="6" GridPane.rowIndex="0">
            <TextField fx:id="destinationField" prefHeight="36" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="ce-to-field" />
            <Button fx:id="toScanBtn" onAction="#onTestMap" styleClass="ce-icon-btn" text="⊕" />
        </HBox>

        <!-- ── Row 1: status label destination ── -->
        <Label fx:id="statusLabelDestination" maxWidth="Infinity" styleClass="status-label" wrapText="true"
               GridPane.columnIndex="6" GridPane.rowIndex="1" GridPane.columnSpan="2" />

        <!-- ── Row 2: Size ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.size"
               GridPane.columnIndex="0" GridPane.rowIndex="2" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.weight"
               GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <TextField fx:id="weightField" prefHeight="36" maxWidth="Infinity" styleClass="input-field"
                   GridPane.columnIndex="2" GridPane.rowIndex="2" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.volume"
               GridPane.columnIndex="5" GridPane.rowIndex="2" />
        <TextField fx:id="volumeField" prefHeight="36" maxWidth="Infinity" styleClass="input-field"
                   GridPane.columnIndex="6" GridPane.rowIndex="2" />

        <!-- ── Row 3: status labels weight / volume ── -->
        <Label fx:id="statusLabelWeight" maxWidth="Infinity" styleClass="status-label" wrapText="true"
               GridPane.columnIndex="2" GridPane.rowIndex="3" GridPane.columnSpan="2" />
        <Label fx:id="statusLabelVolume" maxWidth="Infinity" styleClass="status-label" wrapText="true"
               GridPane.columnIndex="6" GridPane.rowIndex="3" GridPane.columnSpan="2" />

        <!-- ── Row 4: Coefficients ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.coefficients"
               GridPane.columnIndex="0" GridPane.rowIndex="4" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.fuel_surcharge"
               GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <TextField fx:id="fuelSurchargeField" prefHeight="36" maxWidth="Infinity" styleClass="input-field"
                   GridPane.columnIndex="2" GridPane.rowIndex="4" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.toll"
               GridPane.columnIndex="5" GridPane.rowIndex="4" />
        <TextField fx:id="tollField" prefHeight="36" maxWidth="Infinity" styleClass="input-field"
                   GridPane.columnIndex="6" GridPane.rowIndex="4" />

        <!-- ── Row 5: status labels fuel / toll ── -->
        <Label fx:id="statusLabelFuel" maxWidth="Infinity" styleClass="status-label" wrapText="true"
               GridPane.columnIndex="2" GridPane.rowIndex="5" GridPane.columnSpan="2" />
        <Label fx:id="statusLabelToll" maxWidth="Infinity" styleClass="status-label" wrapText="true"
               GridPane.columnIndex="6" GridPane.rowIndex="5" GridPane.columnSpan="2" />

    </GridPane>

    <!-- ADDITIONAL FEES — dynamic sections -->
    <VBox styleClass="ce-fees-body">
        <padding><Insets top="80.0" /></padding>

        <!-- Produkty pre ZBS — radio buttons, populated from DB -->
        <VBox fx:id="productsContainer" spacing="10">
            <padding><Insets bottom="16.0" /></padding>
        </VBox>

        <!-- Obstarávané služby — checkboxes, populated from DB -->
        <VBox fx:id="servicesContainer" spacing="10">
            <padding><Insets bottom="16.0" /></padding>
        </VBox>

        <!-- Príplatky — checkboxes, populated from DB -->
        <VBox fx:id="paymentsContainer" spacing="10" />

    </VBox>

    <!-- BOTTOM ROW -->
    <HBox alignment="CENTER_LEFT" spacing="0" styleClass="ce-bottom-row">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="resetButton" onAction="#onReset" styleClass="secondary-button" text="%cost_estimation.reset" />
        <Button fx:id="computeButton" onAction="#onComputeCost" styleClass="primary-button" text="%cost_estimation.compute">
            <HBox.margin><Insets left="16" /></HBox.margin>
        </Button>
    </HBox>

</VBox>