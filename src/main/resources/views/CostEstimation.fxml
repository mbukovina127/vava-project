<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1340" styleClass="ce-root" stylesheets="@../css/cost_estimation.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.shippin.controller.CostEstimationController">

    <!-- ToggleGroups defined here, referenced via $ below -->
    <fx:define>
        <ToggleGroup fx:id="shipmentTypeGroup"/>
        <ToggleGroup fx:id="deliveryTypeGroup"/>
    </fx:define>

    <!-- TITLE ROW -->
    <HBox alignment="CENTER_LEFT" styleClass="ce-title-row">
        <Label fx:id="sectionTitleLabel" styleClass="ce-title" text="%cost_estimation.title" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Label styleClass="ce-date-label" text="%cost_estimation.date" />
            <TextField fx:id="dateField" prefWidth="130" promptText="%cost_estimation.date.prompt" styleClass="input-field ce-date-field" />
            <Label fx:id="statusLabelDate" maxWidth="200" styleClass="status-label" wrapText="true" />
        </HBox>
    </HBox>

    <!-- TYPE TOGGLES  —  Small Package / Shipment -->
    <HBox alignment="CENTER_LEFT" spacing="24" styleClass="ce-toggle-row">
        <RadioButton fx:id="rbSmallPackage" styleClass="ce-toggle" text="%cost_estimation.small_package"
                     toggleGroup="$shipmentTypeGroup" />
        <RadioButton fx:id="rbShipment" selected="true" styleClass="ce-toggle" text="%cost_estimation.shipment"
                     toggleGroup="$shipmentTypeGroup" />
    </HBox>

    <!-- FIELDS ROW — restructured as a single GridPane for proper alignment -->
    <GridPane hgap="16" vgap="4" styleClass="ce-fields-grid">
        <padding><Insets top="8" bottom="8" /></padding>
        <columnConstraints>
            <!-- Row label (Postal codes / Size / Coefficients) -->
            <ColumnConstraints minWidth="120" prefWidth="140" halignment="LEFT" />
            <!-- Sub-label From/Weight/Fuel — widened so text isn't cramped -->
            <ColumnConstraints minWidth="120" prefWidth="150" halignment="RIGHT" />
            <!-- From field -->
            <ColumnConstraints minWidth="180" prefWidth="200" />
            <!-- Status label From -->
            <ColumnConstraints minWidth="0" prefWidth="160" />
            <!-- Spacer -->
            <ColumnConstraints minWidth="40" prefWidth="60" />
            <!-- Sub-label To/Volume/Toll — widened to match left side -->
            <ColumnConstraints minWidth="80" prefWidth="100" halignment="RIGHT" />
            <!-- To field + button -->
            <ColumnConstraints minWidth="180" prefWidth="220" />
            <!-- Status label To -->
            <ColumnConstraints minWidth="0" prefWidth="160" />
        </columnConstraints>
        <rowConstraints>
            <!-- Row 0: Postal codes -->
            <RowConstraints minHeight="36" prefHeight="40" valignment="CENTER" />
            <!-- Row 1: Status label for destination — sits flush under To field -->
            <RowConstraints minHeight="0" prefHeight="12" valignment="TOP" />
            <!-- Row 2: Size -->
            <RowConstraints minHeight="36" prefHeight="40" valignment="CENTER" />
            <!-- Row 3: Status labels for weight / volume -->
            <RowConstraints minHeight="0" prefHeight="12" valignment="TOP" />
            <!-- Row 4: Coefficients -->
            <RowConstraints minHeight="36" prefHeight="40" valignment="CENTER" />
            <!-- Row 5: Status labels for fuel / toll -->
            <RowConstraints minHeight="0" prefHeight="12" valignment="TOP" />
        </rowConstraints>

        <!-- ── Row 0: Postal codes ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.postal_codes"
               GridPane.columnIndex="0" GridPane.rowIndex="0" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.from"
               GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <ComboBox fx:id="fromCombo" prefHeight="36" prefWidth="200" styleClass="ce-combo"
                  GridPane.columnIndex="2" GridPane.rowIndex="0" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.to"
               GridPane.columnIndex="5" GridPane.rowIndex="0" />
        <!-- To field + scan button in an HBox so button stays flush -->
        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="ce-to-box"
              GridPane.columnIndex="6" GridPane.rowIndex="0">
            <TextField fx:id="destinationField" prefHeight="36" prefWidth="180" styleClass="ce-to-field" />
            <Button fx:id="toScanBtn" styleClass="ce-icon-btn" text="⊕" />
        </HBox>

        <!-- ── Row 1: status label for destination ── -->
        <Label fx:id="statusLabelDestination" maxWidth="220" styleClass="status-label" text="" wrapText="true"
               GridPane.columnIndex="6" GridPane.rowIndex="1" />

        <!-- ── Row 2: Size ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.size"
               GridPane.columnIndex="0" GridPane.rowIndex="2" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.weight"
               GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <TextField fx:id="weightField" prefHeight="36" prefWidth="200" styleClass="input-field"
                   GridPane.columnIndex="2" GridPane.rowIndex="2" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.volume"
               GridPane.columnIndex="5" GridPane.rowIndex="2" />
        <TextField fx:id="volumeField" prefHeight="36" prefWidth="200" styleClass="input-field"
                   GridPane.columnIndex="6" GridPane.rowIndex="2" />

        <!-- ── Row 3: status labels for weight / volume ── -->
        <Label fx:id="statusLabelWeight" maxWidth="200" styleClass="status-label" text="" wrapText="true"
               GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <Label fx:id="statusLabelVolume" maxWidth="200" styleClass="status-label" text="" wrapText="true"
               GridPane.columnIndex="6" GridPane.rowIndex="3" />

        <!-- ── Row 4: Coefficients ── -->
        <Label styleClass="ce-row-label" text="%cost_estimation.coefficients"
               GridPane.columnIndex="0" GridPane.rowIndex="4" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.fuel_surcharge"
               GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <TextField fx:id="fuelSurchargeField" prefHeight="36" prefWidth="200" styleClass="input-field"
                   GridPane.columnIndex="2" GridPane.rowIndex="4" />

        <Label styleClass="ce-sub-label" text="%cost_estimation.toll"
               GridPane.columnIndex="5" GridPane.rowIndex="4" />
        <TextField fx:id="tollField" prefHeight="36" prefWidth="200" styleClass="input-field"
                   GridPane.columnIndex="6" GridPane.rowIndex="4" />

        <!-- ── Row 5: status labels for fuel / toll ── -->
        <Label fx:id="statusLabelFuel" maxWidth="200" styleClass="status-label" text="" wrapText="true"
               GridPane.columnIndex="2" GridPane.rowIndex="5" />
        <Label fx:id="statusLabelToll" maxWidth="200" styleClass="status-label" text="" wrapText="true"
               GridPane.columnIndex="6" GridPane.rowIndex="5" />

    </GridPane>

    <!-- ADDITIONAL FEES TOGGLE -->
    <HBox alignment="CENTER_LEFT" styleClass="ce-fees-header-row">
        <CheckBox fx:id="chkAdditionalFees" selected="true" styleClass="ce-toggle" text="%cost_estimation.additional_fees" />
        <VBox.margin><Insets /></VBox.margin>
        <padding><Insets top="10.0" /></padding>
    </HBox>

    <!-- ADDITIONAL FEES  —  columns -->
    <HBox alignment="TOP_LEFT" spacing="60" styleClass="ce-fees-body">
        <padding><Insets top="20.0" /></padding>

        <!-- Left: Obstarávané služby -->
        <VBox spacing="10">
            <Label styleClass="ce-fees-group-label" text="%cost_estimation.procured_services" />
            <CheckBox fx:id="chkADR"         styleClass="ce-check" text="%cost_estimation.adr" />
            <CheckBox fx:id="chkDobierka"    styleClass="ce-check" text="%cost_estimation.cod" />
            <CheckBox fx:id="chkPripoistenie" styleClass="ce-check" text="%cost_estimation.insurance" />
            <CheckBox fx:id="chkVratenieEUP" styleClass="ce-check" text="%cost_estimation.eup_return" />
        </VBox>

        <!-- Middle: Produkty pre ZBS -->
        <VBox spacing="10">
            <Label styleClass="ce-fees-group-label" text="%cost_estimation.zbs_products" />
            <GridPane hgap="40" vgap="10">
                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
                <CheckBox fx:id="chkPremium"   styleClass="ce-check" text="Premium"    GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <CheckBox fx:id="chkFIX"       styleClass="ce-check" text="FIX"        GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <CheckBox fx:id="chkPremium10" styleClass="ce-check" text="Premium 10" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <CheckBox fx:id="chkFIX10"     styleClass="ce-check" text="FIX 10"     GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <CheckBox fx:id="chkPremium13" styleClass="ce-check" text="Premium 13" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <CheckBox fx:id="chkFIX13"     styleClass="ce-check" text="FIX 13"     GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>
        </VBox>

        <!-- Right: Typ Doručenia -->
        <HBox spacing="24">
            <VBox spacing="10">
                <Label styleClass="ce-fees-group-label" text="%cost_estimation.delivery_type" />
                <RadioButton fx:id="rbExpress" text="%cost_estimation.express" mnemonicParsing="false"
                             toggleGroup="$deliveryTypeGroup" selected="true"
                             styleClass="ce-toggle" />
                <RadioButton fx:id="rbClassic" text="%cost_estimation.classic" mnemonicParsing="false"
                             toggleGroup="$deliveryTypeGroup"
                             styleClass="ce-toggle" />
                <RadioButton fx:id="rbEconomy" text="%cost_estimation.economy" mnemonicParsing="false"
                             toggleGroup="$deliveryTypeGroup"
                             styleClass="ce-toggle" />
            </VBox>
            <VBox spacing="10">
                <Label styleClass="ce-sub-label" text="%cost_estimation.estimated_time" />
                <Label styleClass="ce-sub-label" text="%cost_estimation.time_1_3" />
                <Label styleClass="ce-sub-label" text="%cost_estimation.time_3_7" />
                <Label styleClass="ce-sub-label" text="%cost_estimation.time_7_plus" />
            </VBox>
        </HBox>

    </HBox>

    <!-- BOTTOM ROW -->
    <HBox alignment="CENTER_LEFT" spacing="0" styleClass="ce-bottom-row">
        <Label styleClass="ce-dots" text="• • •" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="resetButton" onAction="#onReset" styleClass="ce-btn-reset" text="%cost_estimation.reset" />
        <Button fx:id="computeButton" onAction="#onComputeCost" styleClass="ce-btn-compute" text="%cost_estimation.compute">
            <HBox.margin><Insets left="16" /></HBox.margin>
        </Button>
    </HBox>

</VBox>