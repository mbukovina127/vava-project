<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.shippin.controller.ShipmentDetailController"
            styleClass="sd-root"
            stylesheets="@../css/shipinn.css, @../css/shipment-detail.css">

    <!-- ══════════════════════════════════════════
         MAIN CONTENT
         ══════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox styleClass="sd-content" spacing="0">

                    <!-- ── Title ───────────────────────────── -->
                    <Label fx:id="titleLabel"
                           text="Shipment details #321"
                           styleClass="sd-title"/>

                    <Region prefHeight="18"/>

                    <!-- ── Total cost row ──────────────────── -->
                    <HBox styleClass="sd-info-row" alignment="CENTER_LEFT" spacing="0">
                        <Label text="Total cost:" styleClass="sd-info-key"/>
                        <Region prefWidth="16"/>
                        <Label fx:id="routeLabel"
                               text="Sklad BA - 14863 (Horná Dolná 28)"
                               styleClass="sd-info-value"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="distanceLabel"
                               text="(210 km)"
                               styleClass="sd-info-muted"/>
                        <Region prefWidth="32"/>
                        <Label fx:id="totalCostLabel"
                               text="54,46 €"
                               styleClass="sd-info-cost"/>
                        <Region prefWidth="20"/>
                        <Button fx:id="costBreakdownBtn"
                                text="Cost breakdown"
                                styleClass="sd-btn-breakdown"
                                onAction="#onCostBreakdown"/>
                    </HBox>

                    <Region prefHeight="18"/>
                    <Separator styleClass="sd-separator"/>
                    <Region prefHeight="18"/>

                    <!-- ── State row ───────────────────────── -->
                    <HBox styleClass="sd-state-row" alignment="CENTER_LEFT" spacing="14">
                        <Label text="State:" styleClass="sd-info-key"/>
                        <Label fx:id="statusBadge"
                               text="COMPLETED"
                               styleClass="sd-badge, sd-badge-completed"/>
                        <Button fx:id="changeStatusBtn"
                                text="Change status"
                                styleClass="sd-btn-action"
                                onAction="#onChangeStatus"/>
                    </HBox>

                    <Region prefHeight="24"/>
                    <Separator styleClass="sd-separator"/>
                    <Region prefHeight="18"/>

                    <!-- ── History header ──────────────────── -->
                    <Label text="History of shipment:" styleClass="sd-section-header"/>
                    <Region prefHeight="12"/>

                    <!-- ── History grid ────────────────────── -->
                    <GridPane fx:id="historyGrid" styleClass="sd-history-grid" hgap="0" vgap="4">
                        <columnConstraints>
                            <!-- Time -->
                            <ColumnConstraints minWidth="80" prefWidth="100"/>
                            <!-- Driver -->
                            <ColumnConstraints minWidth="120" prefWidth="160"/>
                            <!-- Location -->
                            <ColumnConstraints minWidth="120" prefWidth="180"/>
                            <!-- Status -->
                            <ColumnConstraints minWidth="140" prefWidth="200" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <!-- Rows populated programmatically in controller -->
                    </GridPane>

                    <Region prefHeight="28"/>

                    <!-- ── Map view ────────────────────────── -->
                    <StackPane fx:id="mapContainer" styleClass="sd-map-container"
                               prefHeight="200" minHeight="200" maxHeight="200"
                               prefWidth="700" maxWidth="700"
                               alignment="TOP_LEFT">
                        <ImageView fx:id="mapImageView"
                                   fitWidth="700" fitHeight="200"
                                   preserveRatio="false"
                                   styleClass="sd-map-image"/>
                        <Label fx:id="mapFallbackLabel"
                               text="🗺  Map loading…"
                               styleClass="sd-map-fallback"
                               visible="false"/>
                    </StackPane>

                    <Region prefHeight="32"/>

                    <!-- ── Bottom bar ──────────────────────── -->
                    <HBox styleClass="sd-bottom-bar" alignment="CENTER_RIGHT">
                        <Button fx:id="dailySummaryBtn"
                                text="Daily summary"
                                styleClass="sd-btn-action"
                                onAction="#onDailySummary"/>
                    </HBox>

                    <Region prefHeight="24"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
