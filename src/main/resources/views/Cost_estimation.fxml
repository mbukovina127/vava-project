<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<!--
    CSS spec:
        position : relative
        width    : 1440px
        height   : 820px
        background: #FFFFFF
-->
<BorderPane
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.shippin.controller.CostEstimationController"
    prefWidth="1440"
    prefHeight="820"
    minWidth="1440"
    minHeight="820"
    maxWidth="1440"
    maxHeight="820"
    style="-fx-background-color: #FFFFFF;">

    <!-- ══════════════════════════════════════════
         TOP NAV BAR
         SVG: rect x=-1, y=-1, w=1442, h=102
              background: #FFE4CC, border: #1D0000
         ══════════════════════════════════════════ -->
    <top>
        <HBox
            fx:id="topNavBar"
            prefHeight="100"
            prefWidth="1440"
            alignment="CENTER_LEFT"
            style="-fx-background-color: #FFE4CC;
                   -fx-border-color: #1D0000;
                   -fx-border-width: 0 0 2 0;
                   -fx-padding: 0 20 0 20;">

            <!-- Brand logo + name -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView
                    fx:id="brandLogoImageView"
                    fitWidth="55"
                    fitHeight="55"
                    preserveRatio="true"/>
                <Label
                    fx:id="appNameLabel"
                    text="Shipment"
                    style="-fx-font-size: 26px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #000000;"/>
            </HBox>

            <!-- Centre nav links -->
            <HBox alignment="CENTER" spacing="28" HBox.hgrow="ALWAYS">
                <Hyperlink
                    fx:id="navLink1"
                    text="Home"
                    onAction="#onNavHome"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-border-color: transparent;"/>
                <Hyperlink
                    fx:id="navLink2"
                    text="New Shipment"
                    onAction="#onNavNewShipment"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-border-color: transparent;"/>
                <Hyperlink
                    fx:id="navLink3"
                    text="Schedule"
                    onAction="#onNavSchedule"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-border-color: transparent;"/>
                <Hyperlink
                    fx:id="navLink4"
                    text="Shipment Order"
                    onAction="#onNavShipmentOrder"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-border-color: transparent;"/>
                <Hyperlink
                    fx:id="navLink5"
                    text="Cost Estimate"
                    onAction="#onNavCostEstimate"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #000000;
                           -fx-font-weight: bold;
                           -fx-border-color: transparent;"/>
            </HBox>

            <!-- Right: date label + profile button -->
            <HBox alignment="CENTER_RIGHT" spacing="14">
                <Label
                    fx:id="currentDateLabel"
                    text=""
                    style="-fx-font-size: 13px;
                           -fx-text-fill: #000000;"/>
                <!-- Profile circle button — SVG circle r=24.5 at x≈1382,y=54 -->
                <Button
                    fx:id="profileButton"
                    onAction="#onProfileClicked"
                    prefWidth="50"
                    prefHeight="50"
                    style="-fx-background-color: #FFFFFF;
                           -fx-border-color: #000000;
                           -fx-border-width: 1;
                           -fx-border-radius: 25;
                           -fx-background-radius: 25;
                           -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════
         LEFT SIDEBAR
         SVG: rect x=-2, y=99, w=102, h=722
              background: #FFE4CC, border: black
         Six icon buttons each ~73×73, rx=9
         ══════════════════════════════════════════ -->
    <left>
        <VBox
            fx:id="leftSidebar"
            prefWidth="100"
            prefHeight="720"
            spacing="0"
            alignment="TOP_CENTER"
            style="-fx-background-color: #FFE4CC;
                   -fx-border-color: #000000;
                   -fx-border-width: 0 2 0 0;">

            <!-- Item 1 — active (filled dark) -->
            <Button
                fx:id="sidebarBtn1"
                prefWidth="73"
                prefHeight="73"
                onAction="#onSidebarBtn1"
                style="-fx-background-color: #5D3F25;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;">
                <VBox.margin><Insets top="14" left="13" right="14"/></VBox.margin>
            </Button>

            <!-- Item 2 -->
            <Button
                fx:id="sidebarBtn2"
                prefWidth="73"
                prefHeight="73"
                onAction="#onSidebarBtn2"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;">
                <VBox.margin><Insets top="100" left="13" right="14"/></VBox.margin>
            </Button>

            <!-- Item 3 -->
            <Button
                fx:id="sidebarBtn3"
                prefWidth="73"
                prefHeight="73"
                onAction="#onSidebarBtn3"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;">
                <VBox.margin><Insets top="100" left="13" right="14"/></VBox.margin>
            </Button>

            <!-- Item 4 -->
            <Button
                fx:id="sidebarBtn4"
                prefWidth="73"
                prefHeight="73"
                onAction="#onSidebarBtn4"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;">
                <VBox.margin><Insets top="100" left="13" right="14"/></VBox.margin>
            </Button>

            <!-- Item 5 -->
            <Button
                fx:id="sidebarBtn5"
                prefWidth="73"
                prefHeight="73"
                onAction="#onSidebarBtn5"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;">
                <VBox.margin><Insets top="100" left="13" right="14"/></VBox.margin>
            </Button>

            <!-- Item 6 -->
            <Button
                fx:id="sidebarBtn6"
                prefWidth="73"
                prefHeight="73"
                onAction="#onSidebarBtn6"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 9;
                       -fx-border-color: #000000;
                       -fx-border-width: 2;
                       -fx-border-radius: 9;
                       -fx-cursor: hand;">
                <VBox.margin><Insets top="100" left="13" right="14"/></VBox.margin>
            </Button>

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════
         MAIN CONTENT  (background: #FFFFFF)
         ══════════════════════════════════════════ -->
    <center>
        <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            style="-fx-background-color: #FFFFFF;
                   -fx-background: #FFFFFF;
                   -fx-border-color: transparent;">

            <VBox
                spacing="20"
                style="-fx-background-color: #FFFFFF;
                       -fx-padding: 24 32 32 32;">

                <!-- ── MM/YY or Search bar row (SVG white rect at y≈164, w≈179) ── -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label
                        fx:id="sectionTitleLabel"
                        text="Cost Estimation"
                        style="-fx-font-size: 22px;
                               -fx-font-weight: bold;
                               -fx-text-fill: #000000;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Search / filter field (SVG rect near top of content) -->
                    <TextField
                        fx:id="searchField"
                        promptText="Search..."
                        prefWidth="179"
                        prefHeight="44"
                        style="-fx-background-color: #FFFFFF;
                               -fx-border-color: #000000;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-font-size: 13px;
                               -fx-padding: 0 10 0 10;"/>
                </HBox>

                <!-- ══════════════════════════════════════
                     TWO-COLUMN INPUT SECTION
                     Left col:  x≈590, right col: x≈1019
                     Three input rows each (y≈277,332,387)
                     ══════════════════════════════════════ -->
                <HBox spacing="40" alignment="TOP_LEFT">

                    <!-- LEFT COLUMN (approx x=590, width≈244) -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS">

                        <Label
                            text="Shipment Details"
                            style="-fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #000000;"/>

                        <!-- Field 1 — y≈277 -->
                        <VBox spacing="4">
                            <Label
                                fx:id="originLabel"
                                text="Origin"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #000000;"/>
                            <TextField
                                fx:id="originField"
                                promptText="Enter origin"
                                prefHeight="44"
                                style="-fx-background-color: rgba(255,255,255,0.96);
                                       -fx-border-color: #000000;
                                       -fx-border-width: 3;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;
                                       -fx-text-fill: #000000;
                                       -fx-prompt-text-fill: #B3B3B3;
                                       -fx-padding: 0 12 0 12;"/>
                        </VBox>

                        <!-- Field 2 — y≈332 -->
                        <VBox spacing="4">
                            <Label
                                fx:id="destinationLabel"
                                text="Destination"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #000000;"/>
                            <TextField
                                fx:id="destinationField"
                                promptText="Enter destination"
                                prefHeight="44"
                                style="-fx-background-color: rgba(255,255,255,0.96);
                                       -fx-border-color: #000000;
                                       -fx-border-width: 3;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;
                                       -fx-text-fill: #000000;
                                       -fx-prompt-text-fill: #B3B3B3;
                                       -fx-padding: 0 12 0 12;"/>
                        </VBox>

                        <!-- Field 3 — y≈387 (ComboBox with chevron) -->
                        <VBox spacing="4">
                            <Label
                                fx:id="shipmentTypeLabel"
                                text="Shipment Type"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #000000;"/>
                            <ComboBox
                                fx:id="shipmentTypeCombo"
                                promptText="Select type..."
                                prefHeight="44"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: rgba(255,255,255,0.96);
                                       -fx-border-color: #000000;
                                       -fx-border-width: 3;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;"/>
                        </VBox>

                    </VBox>

                    <!-- RIGHT COLUMN (approx x=1019, width≈244) -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS">

                        <Label
                            text="Cargo Details"
                            style="-fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #000000;"/>

                        <!-- Field 4 — y≈276 (has location-pin icon) -->
                        <VBox spacing="4">
                            <Label
                                fx:id="weightLabel"
                                text="Weight (kg)"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #000000;"/>
                            <TextField
                                fx:id="weightField"
                                promptText="Enter weight"
                                prefHeight="44"
                                style="-fx-background-color: rgba(255,255,255,0.96);
                                       -fx-border-color: #000000;
                                       -fx-border-width: 3;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;
                                       -fx-text-fill: #000000;
                                       -fx-prompt-text-fill: #B3B3B3;
                                       -fx-padding: 0 12 0 12;"/>
                        </VBox>

                        <!-- Field 5 — y≈332 -->
                        <VBox spacing="4">
                            <Label
                                fx:id="volumeLabel"
                                text="Volume (m³)"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #000000;"/>
                            <TextField
                                fx:id="volumeField"
                                promptText="Enter volume"
                                prefHeight="44"
                                style="-fx-background-color: rgba(255,255,255,0.96);
                                       -fx-border-color: #000000;
                                       -fx-border-width: 3;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;
                                       -fx-text-fill: #000000;
                                       -fx-prompt-text-fill: #B3B3B3;
                                       -fx-padding: 0 12 0 12;"/>
                        </VBox>

                        <!-- Field 6 — y≈387 -->
                        <VBox spacing="4">
                            <Label
                                fx:id="cargoTypeLabel"
                                text="Cargo Type"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #000000;"/>
                            <ComboBox
                                fx:id="cargoTypeCombo"
                                promptText="Select cargo type..."
                                prefHeight="44"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: rgba(255,255,255,0.96);
                                       -fx-border-color: #000000;
                                       -fx-border-width: 3;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;"/>
                        </VBox>

                    </VBox>
                </HBox>

                <!-- ══════════════════════════════════════
                     ADDRESS / DATA TABLE
                     SVG checkbox grid with D9D9D9 squares
                     ══════════════════════════════════════ -->
                <VBox spacing="10">
                    <Label
                        text="Address Details"
                        style="-fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-text-fill: #000000;"/>

                    <GridPane hgap="32" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="30"  prefWidth="30"/>
                            <ColumnConstraints minWidth="220" prefWidth="280" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="220" prefWidth="280" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="220" prefWidth="280" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- Header row -->
                        <Label text=""            GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Add"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #000000;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Address Details"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #000000;"
                               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Address"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #000000;"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <!-- Row 1 -->
                        <CheckBox fx:id="chkRow1"
                                  style="-fx-background-color: #D9D9D9; -fx-min-width: 20; -fx-min-height: 20;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="addRow1"         promptText="Add..."            prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="addrDetailRow1"  promptText="Detail..."         prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="addrRow1"         promptText="Address..."       prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <!-- Row 2 -->
                        <CheckBox fx:id="chkRow2"
                                  style="-fx-background-color: #D9D9D9; -fx-min-width: 20; -fx-min-height: 20;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="addRow2"         promptText="Add..."            prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <TextField fx:id="addrDetailRow2"  promptText="Detail..."         prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <TextField fx:id="addrRow2"         promptText="Address..."       prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                        <!-- Row 3 -->
                        <CheckBox fx:id="chkRow3"
                                  style="-fx-background-color: #D9D9D9; -fx-min-width: 20; -fx-min-height: 20;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="addRow3"         promptText="Add..."            prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <TextField fx:id="addrDetailRow3"  promptText="Detail..."         prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <TextField fx:id="addrRow3"         promptText="Address..."       prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                        <!-- Row 4 -->
                        <CheckBox fx:id="chkRow4"
                                  style="-fx-background-color: #D9D9D9; -fx-min-width: 20; -fx-min-height: 20;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="addRow4"         promptText="Add..."            prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <TextField fx:id="addrDetailRow4"  promptText="Detail..."         prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                        <TextField fx:id="addrRow4"         promptText="Address..."       prefHeight="36"
                                   style="-fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #FFFFFF; -fx-font-size: 13px;"
                                   GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                    </GridPane>
                </VBox>

                <!-- ── Status label ── -->
                <Label
                    fx:id="statusLabel"
                    text=""
                    style="-fx-font-size: 12px; -fx-text-fill: #CC0000;"/>

                <!-- ── Estimated cost result (hidden until computed) ── -->
                <HBox
                    fx:id="resultBox"
                    spacing="14"
                    alignment="CENTER_LEFT"
                    visible="false"
                    style="-fx-padding: 14 18;
                           -fx-background-color: #F5F0EB;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;">
                    <Label
                        text="Estimated Cost:"
                        style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
                    <Label
                        fx:id="estimatedCostLabel"
                        text="\$0.00"
                        style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5D3F25;"/>
                </HBox>

                <!-- ══════════════════════════════════════
                     BOTTOM ACTION BUTTONS
                     SVG: Reset  rect x=882,y=713, w=166,h=59
                          Compute rect x=1078,y=713,w=278,h=59
                          Reset   fill=white, stroke=black
                          Compute fill=#686868, stroke=black
                     ══════════════════════════════════════ -->
                <HBox spacing="16" alignment="CENTER_RIGHT">

                    <Button
                        fx:id="resetButton"
                        text="Reset"
                        prefWidth="166"
                        prefHeight="59"
                        onAction="#onReset"
                        style="-fx-background-color: #FFFFFF;
                               -fx-text-fill: #000000;
                               -fx-font-size: 14px;
                               -fx-border-color: #000000;
                               -fx-border-width: 2;
                               -fx-border-radius: 9;
                               -fx-background-radius: 9;
                               -fx-cursor: hand;"/>

                    <Button
                        fx:id="computeButton"
                        text="Compute Cost estimate"
                        prefWidth="278"
                        prefHeight="59"
                        onAction="#onComputeCost"
                        style="-fx-background-color: #686868;
                               -fx-text-fill: #FFFFFF;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-border-color: #000000;
                               -fx-border-width: 2;
                               -fx-border-radius: 9;
                               -fx-background-radius: 9;
                               -fx-cursor: hand;"/>

                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
