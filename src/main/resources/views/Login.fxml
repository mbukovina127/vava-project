<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<StackPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.shippin.controller.LoginController"
        prefWidth="1440"
        prefHeight="820"
        styleClass="root-pane"
        stylesheets="@../css/shipinn.css, @../css/login-page.css">

    <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
        <padding><Insets top="12" right="16"/></padding>
        <Button
                fx:id="langButton"
                text="SK"
                onAction="#onToggleLanguage"
                styleClass="locale-btn"/>
    </HBox>

    <VBox
            styleClass="card"
            maxWidth="380"
            alignment="CENTER">

        <!-- Logo -->
        <HBox styleClass="logo-box">
            <!-- Picture (logo) -->
            <ImageView fitHeight="50" preserveRatio="true">
                <Image url="@../icons/png-dark/logoShippin_black.png"/>
            </ImageView>
            <Label styleClass="logo-name" text="%login.logo"/>
        </HBox>

        <!-- Email -->
        <Label styleClass="field-label" text="%login.email"/>
        <TextField
                fx:id="emailTextField"
                styleClass="input-field"
                promptText="%login.email.prompt"/>

        <!-- error label (email) -->
        <Label
                fx:id="statusLabelEmail"
                styleClass="status-label"
                text=""
                wrapText="true"
                maxWidth="360"/>

        <!-- Password -->
        <Label styleClass="field-label" text="%login.password"/>
        <HBox fx:id="passwordWrapper" styleClass="password-wrapper" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <PasswordField
                    fx:id="passwordField"
                    styleClass="password-input"
                    promptText="%login.password.prompt"
                    HBox.hgrow="ALWAYS"/>
            <TextField
                    fx:id="passwordVisible"
                    styleClass="password-input"
                    promptText="%login.password.prompt"
                    managed="false"
                    visible="false"
                    HBox.hgrow="ALWAYS"/>
            <Button
                    fx:id="eyeButton"
                    styleClass="eye-btn"
                    text="◉"
                    onAction="#onTogglePassword"/>
        </HBox>

        <!-- error label (password) -->
        <Label
                fx:id="statusLabelPass"
                styleClass="status-label"
                text=""
                wrapText="true"
                maxWidth="360"/>

        <!-- Login button -->
        <Button
                fx:id="loginButton"
                styleClass="primary-button"
                text="%login.button"
                maxWidth="Infinity"
                onAction="#onLogin"/>

        <!-- Register link -->
        <HBox styleClass="bottom-link-box">
            <Label styleClass="muted-text" text="%login.no_account"/>
            <Hyperlink
                    fx:id="registerLink"
                    styleClass="register-link"
                    text="%login.register_link"
                    onAction="#onGoToRegister"/>
        </HBox>
    </VBox>

</StackPane>