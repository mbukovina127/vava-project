<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.shippin.controller.CostBreakdownController"
>

    <!-- ── Main content ──────────────────────────────────────────────────── -->
    <VBox
            styleClass="ce-root"
            stylesheets="@../css/shipinn.css, @../css/cost_estimation.css"
            prefWidth="1340"
    >

        <!-- TITLE ROW -->
        <HBox alignment="CENTER_LEFT" styleClass="ce-title-row">
            <Label text="%cost_breakdown.title" styleClass="ce-title" />
        </HBox>

        <!-- Main breakdown grid, populated dynamically from CostEstimationInput -->
        <GridPane fx:id="breakdownGrid" styleClass="cb-grid" hgap="0" vgap="4">
            <columnConstraints>
                <!-- Label column -->
                <ColumnConstraints hgrow="ALWAYS" />
                <!-- Value column, right-aligned -->
                <ColumnConstraints minWidth="120" halignment="RIGHT" />
            </columnConstraints>
            <padding><Insets top="16" right="24" bottom="8" left="24" /></padding>
        </GridPane>

        <Region VBox.vgrow="ALWAYS" />

        <!-- BOTTOM ROW -->
        <HBox styleClass="ce-bottom-row" alignment="CENTER_LEFT" spacing="0">

            <Button
                    fx:id="deleteButton"
                    text="%cost_breakdown.delete"
                    onAction="#onDelete"
                    styleClass="cb-btn-delete" />

            <Region HBox.hgrow="ALWAYS" />

            <Button
                    fx:id="printPdfButton"
                    text="%cost_breakdown.print_pdf"
                    onAction="#onPrintPdf"
                    styleClass="ce-btn-reset"
                    prefWidth="160"
                    prefHeight="46" />

            <Button
                    fx:id="saveButton"
                    text="%cost_breakdown.save"
                    onAction="#onSave"
                    styleClass="ce-btn-compute"
                    prefWidth="200"
                    prefHeight="46">
                <HBox.margin><Insets left="16" /></HBox.margin>
            </Button>

        </HBox>

    </VBox>

    <!-- ── Modal overlay (hidden by default) ─────────────────────────────── -->
    <StackPane
            fx:id="modalOverlay"
            styleClass="modal-overlay"
            visible="false"
            managed="false"
    >
        <VBox
                fx:id="modalContentHolder"
                styleClass="modal-content-holder"
                alignment="CENTER"
                visible="false"
                managed="false"
        />
    </StackPane>

</StackPane>